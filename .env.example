# Redis / ARQ
REDIS_DSN=redis://localhost:6379
ARQ_MAX_JOBS=2
ARQ_JOB_TIMEOUT=900

# PostgreSQL (durable extracted-job storage)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobintel
POSTGRES_PASSWORD=jobintel
POSTGRES_DB=jobintel
# Optional override. Inside Docker/Kubernetes this is built from the POSTGRES_* values.
# DATABASE_URL=postgresql+asyncpg://jobintel:jobintel@localhost:5432/jobintel

# OpenRouter (OpenAI-compatible LLM API)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Bounded LLM processing
LLM_MAX_CONCURRENT=5
LLM_MAX_TRIES=3
LLM_JOB_TIMEOUT=60

# LangSmith observability and evaluation
# Create a key at https://smith.langchain.com/settings
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-intelligence
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
